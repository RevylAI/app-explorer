---
/**
 * Atlas Report Viewer — standalone template.
 *
 * To use: place your screen-map.json and screenshots in public/data/
 * then run `npm run dev` to view the interactive report.
 */
import { AtlasGraph } from './components/AtlasGraph';
import { AtlasReport } from './components/AtlasReport';

// Load screen map at build time
let screenMap;
try {
  const fs = await import('node:fs');
  const path = await import('node:path');
  const filePath = path.join(process.cwd(), 'public', 'data', 'screen-map.json');
  screenMap = JSON.parse(fs.readFileSync(filePath, 'utf-8'));
} catch {
  screenMap = { app_name: "App", platform: "unknown", screens: [], transitions: [] };
}

const totalElements = screenMap.screens.reduce((sum: number, s: any) => sum + s.elements.length, 0);

function countPaths(sm: any): number {
  if (!sm.screens.length) return 0;
  const adj: Record<string, string[]> = {};
  for (const t of (Array.isArray(sm.transitions) ? sm.transitions : [])) {
    if (!adj[t.from_screen]) adj[t.from_screen] = [];
    if (!adj[t.from_screen].includes(t.to_screen)) adj[t.from_screen].push(t.to_screen);
  }
  const start = sm.screens[0].screen_id;
  let count = 0;
  function dfs(node: string, path: string[]) {
    if (count >= 20) return;
    const neighbors = (adj[node] || []).filter((n: string) => !path.includes(n));
    if (neighbors.length === 0 && path.length > 1) { count++; return; }
    for (const n of neighbors) { path.push(n); dfs(n, path); path.pop(); }
  }
  dfs(start, [start]);
  return count;
}
const totalPaths = countPaths(screenMap);
---

<!doctype html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={`Interactive screen map of ${screenMap.app_name}. ${screenMap.screens.length} screens mapped by AI.`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <title>{screenMap.app_name} — Screen Map | Atlas</title>
  <script is:inline>
    const stored = localStorage.getItem('atlas-theme');
    if (stored === 'light') document.documentElement.classList.remove('dark');
  </script>
</head>
<body class="m-0 p-0 overflow-hidden bg-white dark:bg-zinc-950 text-gray-900 dark:text-gray-100" style="font-family: Inter, system-ui, sans-serif;">
  <div id="atlas-root" class="flex flex-col" style="height: 100dvh;">

    <!-- Toolbar -->
    <div class="shrink-0 border-b border-gray-200 dark:border-gray-800 bg-gray-50/80 dark:bg-zinc-900/80 backdrop-blur-sm z-20">
      <!-- Mobile toolbar (≤768px) -->
      <div class="md:hidden">
        <!-- Row 1: brand + title + theme toggle -->
        <div class="flex items-center justify-between px-3 py-2.5 border-b border-gray-100 dark:border-gray-800">
          <span class="text-[10px] font-mono text-[#9D61FF] uppercase tracking-widest">Atlas</span>
          <div class="flex items-center gap-1.5 min-w-0">
            <h1 class="text-sm font-semibold text-gray-800 dark:text-gray-200 truncate">{screenMap.app_name}</h1>
            <span class="text-[8px] font-mono px-1 py-0.5 bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 uppercase border border-gray-200 dark:border-gray-700 shrink-0">{screenMap.platform}</span>
          </div>
          <button onclick="toggleTheme()" class="w-7 h-7 flex items-center justify-center text-gray-400 hover:text-gray-700 dark:hover:text-white transition-colors" title="Toggle theme">
            <svg class="hidden dark:block w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"/></svg>
            <svg class="block dark:hidden w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
          </button>
        </div>
        <!-- Row 2: tabs full-width segmented -->
        <div class="flex">
          <button data-tab="map" class="atlas-tab atlas-tab-active atlas-mobile-tab" onclick="switchTab('map')">Map</button>
          <button data-tab="screens" class="atlas-tab atlas-mobile-tab" onclick="switchTab('screens')">Screens</button>
          <button data-tab="report" class="atlas-tab atlas-mobile-tab" onclick="switchTab('report')">Report</button>
        </div>
        <!-- Row 3: stats banner (hides on Report tab) -->
        <div id="atlas-mobile-stats" class="flex items-center justify-center gap-3 py-1.5 text-[10px] font-mono text-gray-500 dark:text-gray-400 bg-gray-100/50 dark:bg-zinc-900 border-t border-gray-100 dark:border-gray-800">
          <span><span class="font-semibold text-gray-800 dark:text-gray-200 tabular-nums">{screenMap.screens.length}</span> screens</span>
          <span class="text-gray-300 dark:text-gray-700">·</span>
          <span><span class="font-semibold text-gray-800 dark:text-gray-200 tabular-nums">{totalPaths}</span> paths</span>
          <span class="text-gray-300 dark:text-gray-700">·</span>
          <span><span class="font-semibold text-gray-800 dark:text-gray-200 tabular-nums">{totalElements}</span> elements</span>
        </div>
      </div>

      <!-- Desktop toolbar (>768px) -->
      <div class="hidden md:flex px-4 py-2.5 items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-[10px] font-mono text-[#9D61FF] uppercase tracking-widest">Atlas</span>
          <span class="text-gray-300 dark:text-gray-700">/</span>
          <h1 class="text-sm font-medium text-gray-800 dark:text-gray-200 tracking-tight">{screenMap.app_name}</h1>
          <span class="text-[9px] font-mono px-1.5 py-0.5 bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 uppercase tracking-wider border border-gray-200 dark:border-gray-700">{screenMap.platform}</span>
        </div>

        <!-- Tabs -->
        <div class="flex items-center border border-gray-200 dark:border-gray-700">
          <button id="tab-map" data-tab="map" class="atlas-tab atlas-tab-active atlas-desktop-tab border-r border-gray-200 dark:border-gray-700" onclick="switchTab('map')">Map</button>
          <button id="tab-screens" data-tab="screens" class="atlas-tab atlas-desktop-tab border-r border-gray-200 dark:border-gray-700" onclick="switchTab('screens')">Screens ({screenMap.screens.length})</button>
          <button id="tab-report" data-tab="report" class="atlas-tab atlas-desktop-tab" onclick="switchTab('report')">Report</button>
        </div>

        <!-- Stats + theme toggle -->
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-4">
            <div class="flex items-center gap-1.5">
              <span class="text-[9px] font-mono text-gray-400 uppercase tracking-wider">Screens</span>
              <span class="text-xs font-semibold tabular-nums" style="font-family: 'JetBrains Mono', monospace;">{screenMap.screens.length}</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-[9px] font-mono text-gray-400 uppercase tracking-wider">Paths</span>
              <span class="text-xs font-semibold tabular-nums" style="font-family: 'JetBrains Mono', monospace;">{totalPaths}</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-[9px] font-mono text-gray-400 uppercase tracking-wider">Elements</span>
              <span class="text-xs font-semibold tabular-nums" style="font-family: 'JetBrains Mono', monospace;">{totalElements}</span>
            </div>
          </div>
          <div class="w-px h-5 bg-gray-200 dark:bg-gray-700"></div>
          <button onclick="toggleTheme()" class="w-7 h-7 flex items-center justify-center text-gray-400 hover:text-gray-700 dark:hover:text-white hover:bg-gray-200 dark:hover:bg-gray-800 transition-colors" title="Toggle theme">
            <svg class="hidden dark:block w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"/></svg>
            <svg class="block dark:hidden w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Tab: Map -->
    <div id="panel-map" class="flex-1 relative" style="min-height: 0;">
      <AtlasGraph client:only="react" screenMap={screenMap} screenshotBase="/data" />
      <!-- Mobile-only floating toggle for the Journeys drawer -->
      <button
        id="atlas-journeys-toggle"
        class="md:hidden absolute bottom-4 left-4 z-30 px-3 py-2 bg-[#9D61FF] text-white text-[11px] font-mono uppercase tracking-wider shadow-lg flex items-center gap-1.5"
        onclick="document.body.classList.toggle('atlas-journeys-open')"
      >
        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M2 4h12v1H2zm0 4h12v1H2zm0 4h12v1H2z"/></svg>
        Journeys
      </button>
      <div id="atlas-journeys-backdrop" class="md:hidden" onclick="document.body.classList.remove('atlas-journeys-open')"></div>
    </div>

    <!-- Tab: Screens -->
    <div id="panel-screens" class="flex-1 overflow-y-auto bg-gray-50 dark:bg-zinc-950" style="display: none;">
      <div class="p-6">
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 xl:grid-cols-7 gap-4">
          {screenMap.screens.map((screen: any) => {
            const imgName = screen.screenshot.split('/').pop();
            return (
              <div class="group border border-gray-200 dark:border-gray-700 bg-white dark:bg-zinc-900 overflow-hidden hover:border-[#9D61FF]/50 transition-all cursor-pointer" onclick={`expandImage('/data/${imgName}')`}>
                <div class="px-2.5 py-2">
                  <div class="text-[10px] font-semibold text-gray-800 dark:text-gray-200 truncate">{screen.title}</div>
                </div>
                <div class="p-1.5 pt-0">
                  <div class="aspect-[9/19] overflow-hidden bg-white dark:bg-black">
                    <img src={`/data/${imgName}`} alt={screen.title} class="w-full h-full object-contain" loading="lazy" />
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>

    <!-- Tab: Report -->
    <div id="panel-report" class="flex-1 overflow-y-auto bg-white dark:bg-zinc-950" style="display: none;">
      <AtlasReport client:only="react" screenMap={screenMap} screenshotBase="/data" />
    </div>

    <!-- Bottom bar — desktop: origin link / mobile: inline text -->
    <div class="atlas-bottom-bar shrink-0 border-t border-gray-200 dark:border-gray-800 bg-gray-50/80 dark:bg-zinc-900/80 backdrop-blur-sm z-20">
      <!-- Desktop -->
      <div class="hidden md:flex px-4 py-2 items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-mono text-gray-400">Generated by</span>
          <span class="text-[10px] font-mono text-[#9D61FF] font-medium">Atlas</span>
        </div>
        <a href="https://github.com/RevylAI/app-explorer" class="text-[10px] font-mono text-gray-400 hover:text-[#9D61FF] transition-colors">
          github.com/RevylAI/app-explorer
        </a>
      </div>
      <!-- Mobile -->
      <div class="md:hidden flex items-center justify-center gap-2 px-4 py-2 flex-wrap">
        <span class="text-[10px] font-mono text-gray-400 whitespace-nowrap">
          AI-powered app exploration
        </span>
        <span class="text-[10px] font-mono text-gray-300 dark:text-gray-700">|</span>
        <a href="https://github.com/RevylAI/app-explorer" class="text-[10px] font-mono text-[#9D61FF] hover:text-[#b07fff] transition-colors whitespace-nowrap">
          GitHub &rarr;
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    // Shared tab switcher: works for both desktop (id="tab-*") and mobile (data-tab only)
    // tab buttons via data-tab attribute + .atlas-tab-active class.
    function switchTab(tab) {
      var tabs = ['map', 'screens', 'report'];
      tabs.forEach(function(t) {
        var panel = document.getElementById('panel-' + t);
        if (!panel) return;
        panel.style.display = (t === tab) ? '' : 'none';
      });
      document.querySelectorAll('.atlas-tab[data-tab]').forEach(function(b) {
        if (b.dataset.tab === tab) b.classList.add('atlas-tab-active');
        else b.classList.remove('atlas-tab-active');
      });
      // Close the mobile journeys drawer when changing tabs
      document.body.classList.remove('atlas-journeys-open');
      // Hide the mobile stats banner on Report (redundant with report's own Summary section)
      var stats = document.getElementById('atlas-mobile-stats');
      if (stats) stats.style.display = (tab === 'report') ? 'none' : '';
    }
    function toggleTheme() {
      var html = document.documentElement;
      if (html.classList.contains('dark')) { html.classList.remove('dark'); localStorage.setItem('atlas-theme', 'light'); }
      else { html.classList.add('dark'); localStorage.setItem('atlas-theme', 'dark'); }
    }
    function expandImage(src) {
      var overlay = document.createElement('div');
      overlay.style.cssText = 'position:fixed;inset:0;z-index:100;background:rgba(0,0,0,0.85);display:flex;align-items:center;justify-content:center;padding:2rem;cursor:pointer;backdrop-filter:blur(4px)';
      var img = document.createElement('img');
      img.src = src;
      img.style.cssText = 'max-height:90vh;max-width:90vw;object-fit:contain;box-shadow:0 25px 50px rgba(0,0,0,0.5)';
      overlay.appendChild(img);
      overlay.addEventListener('click', function() { document.body.removeChild(overlay); });
      document.body.appendChild(overlay);
    }
    window.switchTab = switchTab;
    window.toggleTheme = toggleTheme;
    window.expandImage = expandImage;
  </script>
</body>
</html>

<style is:global>
  /* ReactFlow controls */
  .react-flow__controls { border-radius: 0 !important; }
  .react-flow__controls button { border-radius: 0 !important; background: white !important; border-color: #e5e7eb !important; color: #6b7280 !important; }
  .react-flow__controls button:hover { background: rgba(157,97,255,0.1) !important; color: #9D61FF !important; }
  .dark .react-flow__controls button { background: #18181b !important; border-color: #374151 !important; color: #9ca3af !important; }
  .dark .react-flow__controls button:hover { background: rgba(157,97,255,0.15) !important; color: #C4A1FF !important; }
  .react-flow__controls button svg { fill: currentColor !important; }
  .react-flow__minimap { border-radius: 0 !important; }
  .react-flow__node.atlas-dimmed { opacity: 0.12 !important; transition: opacity 0.3s !important; }
  .react-flow__node:not(.atlas-dimmed) { transition: opacity 0.3s; }

  /* Tab styles (shared desktop + mobile, controlled by data-tab + atlas-tab-active) */
  .atlas-desktop-tab {
    padding: 6px 20px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #6b7280;
    background: transparent;
    transition: color 0.15s, background 0.15s;
    cursor: pointer;
  }
  .atlas-desktop-tab:hover { color: #374151; }
  .dark .atlas-desktop-tab { color: #9ca3af; }
  .dark .atlas-desktop-tab:hover { color: #d1d5db; }
  .atlas-mobile-tab {
    flex: 1;
    padding: 12px 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #6b7280;
    background: transparent;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
    cursor: pointer;
  }
  .dark .atlas-mobile-tab { color: #9ca3af; }
  .atlas-tab-active {
    background: rgba(157, 97, 255, 0.10) !important;
    color: #9D61FF !important;
    font-weight: 500 !important;
  }
  .atlas-mobile-tab.atlas-tab-active { border-bottom-color: #9D61FF !important; }

  /* Mobile re-flow (≤768px) */
  @media (max-width: 768px) {
    /* JourneyPanel becomes an off-canvas drawer when no path is selected */
    .atlas-journey-panel {
      position: absolute !important;
      left: 0; top: 0; bottom: 0;
      z-index: 40;
      width: 86vw !important;
      max-width: 340px;
      transform: translateX(-100%);
      transition: transform 0.25s ease;
      box-shadow: 4px 0 24px rgba(0, 0, 0, 0);
    }
    body.atlas-journeys-open .atlas-journey-panel {
      transform: translateX(0);
      box-shadow: 4px 0 24px rgba(0, 0, 0, 0.4);
    }
    #atlas-journeys-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s;
      z-index: 39;
    }
    body.atlas-journeys-open #atlas-journeys-backdrop {
      opacity: 1;
      pointer-events: auto;
    }
    body.atlas-journeys-open #atlas-journeys-toggle {
      opacity: 0;
      pointer-events: none;
    }
    #atlas-journeys-toggle { transition: opacity 0.2s; }

    /* ScreenPanel becomes a fullscreen overlay */
    .atlas-screen-panel {
      position: fixed !important;
      inset: 0 !important;
      width: 100vw !important;
      max-width: 100vw !important;
      z-index: 60;
      border-left: none !important;
    }

    /* When a journey IS selected, the JourneyPanel transforms into a fixed
       bottom-bar navigator so the map is visible above while stepping through
       the path. Regular bottom bar + journeys toggle hide to make room. */
    .atlas-journey-panel--active {
      position: fixed !important;
      left: 0 !important; right: 0 !important; bottom: 0 !important; top: auto !important;
      width: 100vw !important; max-width: 100vw !important;
      height: auto !important; max-height: 50vh;
      transform: translateY(0) !important;
      z-index: 50;
      border-right: none !important;
      border-top: 1px solid rgba(0, 0, 0, 0.1);
      box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.4);
    }
    .dark .atlas-journey-panel--active { border-top-color: rgba(255, 255, 255, 0.1); }
    .atlas-journey-panel--active .atlas-journey-step-timeline { display: none !important; }
    .atlas-journey-panel--active .atlas-journey-stepper-header { padding: 10px 16px !important; }
    .atlas-journey-panel--active .atlas-journey-stepper-controls { padding: 12px 16px !important; }
    body.atlas-mobile-journey-active .atlas-bottom-bar { display: none !important; }
    body.atlas-mobile-journey-active #atlas-journeys-toggle { display: none !important; }
    body.atlas-mobile-journey-active #atlas-journeys-backdrop { display: none !important; }

    /* Report view: tighter padding (its own component handles table-vs-list swap) */
    #panel-report .max-w-4xl { padding: 16px !important; }
    /* Hide ReactFlow zoom/fit controls on mobile (pinch-to-zoom still works) */
    .react-flow__controls { display: none !important; }
    /* Bottom bar stays single row on mobile */
    .atlas-bottom-bar { padding: 8px 12px !important; }
  }

  /* Lowkey scrollbars across every scroll area (webkit + firefox) */
  * {
    scrollbar-width: thin;
    scrollbar-color: rgba(148, 163, 184, 0.25) transparent;
  }
  .dark * { scrollbar-color: rgba(148, 163, 184, 0.18) transparent; }
  *::-webkit-scrollbar { width: 6px; height: 6px; }
  *::-webkit-scrollbar-track { background: transparent; }
  *::-webkit-scrollbar-thumb { background-color: rgba(148, 163, 184, 0.25); border-radius: 0; }
  *::-webkit-scrollbar-thumb:hover { background-color: rgba(148, 163, 184, 0.5); }
  .dark *::-webkit-scrollbar-thumb { background-color: rgba(148, 163, 184, 0.18); }
  .dark *::-webkit-scrollbar-thumb:hover { background-color: rgba(148, 163, 184, 0.4); }
</style>
