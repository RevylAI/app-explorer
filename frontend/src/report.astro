---
/**
 * Atlas Report Viewer — standalone template.
 *
 * To use: place your screen-map.json and screenshots in public/data/
 * then run `npm run dev` to view the interactive report.
 */
import { AtlasGraph } from './components/AtlasGraph';
import { AtlasReport } from './components/AtlasReport';

// Load screen map at build time
let screenMap;
try {
  const fs = await import('node:fs');
  const path = await import('node:path');
  const filePath = path.join(process.cwd(), 'public', 'data', 'screen-map.json');
  screenMap = JSON.parse(fs.readFileSync(filePath, 'utf-8'));
} catch {
  screenMap = { app_name: "App", platform: "unknown", screens: [], transitions: [] };
}

const totalElements = screenMap.screens.reduce((sum: number, s: any) => sum + s.elements.length, 0);

function countPaths(sm: any): number {
  if (!sm.screens.length) return 0;
  const adj: Record<string, string[]> = {};
  for (const t of sm.transitions) {
    if (!adj[t.from_screen]) adj[t.from_screen] = [];
    if (!adj[t.from_screen].includes(t.to_screen)) adj[t.from_screen].push(t.to_screen);
  }
  const start = sm.screens[0].screen_id;
  let count = 0;
  function dfs(node: string, path: string[]) {
    if (count >= 20) return;
    const neighbors = (adj[node] || []).filter((n: string) => !path.includes(n));
    if (neighbors.length === 0 && path.length > 1) { count++; return; }
    for (const n of neighbors) { path.push(n); dfs(n, path); path.pop(); }
  }
  dfs(start, [start]);
  return count;
}
const totalPaths = countPaths(screenMap);
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'http://localhost:4321');
---

<!doctype html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={`Interactive screen map of ${screenMap.app_name}. ${screenMap.screens.length} screens mapped by AI.`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <title>{screenMap.app_name} — Screen Map | Atlas</title>
  <script is:inline>
    const stored = localStorage.getItem('atlas-theme');
    if (stored === 'light') document.documentElement.classList.remove('dark');
  </script>
</head>
<body class="m-0 p-0 overflow-hidden bg-white dark:bg-zinc-950 text-gray-900 dark:text-gray-100" style="font-family: Inter, system-ui, sans-serif;">
  <div class="flex flex-col" style="height: 100vh;">

    <!-- Toolbar -->
    <div class="shrink-0 border-b border-gray-200 dark:border-gray-800 bg-gray-50/80 dark:bg-zinc-900/80 backdrop-blur-sm z-20">
      <div class="px-4 py-2.5 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-[10px] font-mono text-[#9D61FF] uppercase tracking-widest">Atlas</span>
          <span class="text-gray-300 dark:text-gray-700">/</span>
          <h1 class="text-sm font-medium text-gray-800 dark:text-gray-200 tracking-tight">
            {screenMap.app_name}
          </h1>
          <span class="text-[9px] font-mono px-1.5 py-0.5 bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 uppercase tracking-wider border border-gray-200 dark:border-gray-700">
            {screenMap.platform}
          </span>
        </div>

        <!-- Tabs -->
        <div class="flex items-center border border-gray-200 dark:border-gray-700">
          <button id="tab-map" class="atlas-tab px-5 py-1.5 text-[10px] font-mono uppercase tracking-wider transition-colors bg-[#9D61FF]/10 text-[#9D61FF] font-medium border-r border-gray-200 dark:border-gray-700" onclick="switchTab('map')">Map</button>
          <button id="tab-screens" class="atlas-tab px-5 py-1.5 text-[10px] font-mono uppercase tracking-wider transition-colors text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 border-r border-gray-200 dark:border-gray-700" onclick="switchTab('screens')">Screens ({screenMap.screens.length})</button>
          <button id="tab-report" class="atlas-tab px-5 py-1.5 text-[10px] font-mono uppercase tracking-wider transition-colors text-gray-500 hover:text-gray-700 dark:hover:text-gray-300" onclick="switchTab('report')">Report</button>
        </div>

        <!-- Stats + theme toggle -->
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-4">
            <div class="flex items-center gap-1.5">
              <span class="text-[9px] font-mono text-gray-400 uppercase tracking-wider">Screens</span>
              <span class="text-xs font-semibold tabular-nums" style="font-family: 'JetBrains Mono', monospace;">{screenMap.screens.length}</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-[9px] font-mono text-gray-400 uppercase tracking-wider">Paths</span>
              <span class="text-xs font-semibold tabular-nums" style="font-family: 'JetBrains Mono', monospace;">{totalPaths}</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-[9px] font-mono text-gray-400 uppercase tracking-wider">Elements</span>
              <span class="text-xs font-semibold tabular-nums" style="font-family: 'JetBrains Mono', monospace;">{totalElements}</span>
            </div>
          </div>
          <div class="w-px h-5 bg-gray-200 dark:bg-gray-700"></div>
          <button onclick="toggleTheme()" class="w-7 h-7 flex items-center justify-center text-gray-400 hover:text-gray-700 dark:hover:text-white hover:bg-gray-200 dark:hover:bg-gray-800 transition-colors" title="Toggle theme">
            <svg id="icon-sun" class="hidden dark:block w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"/></svg>
            <svg id="icon-moon" class="block dark:hidden w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Tab: Map -->
    <div id="panel-map" class="flex-1 relative" style="min-height: 0;">
      <AtlasGraph client:only="react" screenMap={screenMap} screenshotBase="/data" />
    </div>

    <!-- Tab: Screens -->
    <div id="panel-screens" class="flex-1 overflow-y-auto bg-gray-50 dark:bg-zinc-950" style="display: none;">
      <div class="p-6">
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 xl:grid-cols-7 gap-4">
          {screenMap.screens.map((screen: any) => {
            const imgName = screen.screenshot.split('/').pop();
            return (
              <div class="group border border-gray-200 dark:border-gray-700 bg-white dark:bg-zinc-900 overflow-hidden hover:border-[#9D61FF]/50 transition-all cursor-pointer" onclick={`expandImage('/data/${imgName}')`}>
                <div class="px-2.5 py-2">
                  <div class="text-[10px] font-semibold text-gray-800 dark:text-gray-200 truncate">{screen.title}</div>
                </div>
                <div class="p-1.5 pt-0">
                  <div class="aspect-[9/19] overflow-hidden bg-white dark:bg-black">
                    <img src={`/data/${imgName}`} alt={screen.title} class="w-full h-full object-contain" loading="lazy" />
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>

    <!-- Tab: Report -->
    <div id="panel-report" class="flex-1 overflow-y-auto bg-white dark:bg-zinc-950" style="display: none;">
      <AtlasReport client:only="react" screenMap={screenMap} screenshotBase="/data" />
    </div>

    <!-- Bottom bar -->
    <div class="shrink-0 border-t border-gray-200 dark:border-gray-800 bg-gray-50/80 dark:bg-zinc-900/80 backdrop-blur-sm px-4 py-2 flex items-center justify-between z-20">
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-mono text-gray-400">Generated by</span>
        <span class="text-[10px] font-mono text-[#9D61FF] font-medium">Atlas</span>
      </div>
      <a href="https://github.com/RevylAI/app-explorer" class="text-[10px] font-mono text-gray-400 hover:text-[#9D61FF] transition-colors">
        github.com/RevylAI/app-explorer
      </a>
    </div>
  </div>

  <script is:inline>
    function switchTab(tab) {
      var tabs = ['map', 'screens', 'report'];
      var activeClass = 'atlas-tab px-5 py-1.5 text-[10px] font-mono uppercase tracking-wider transition-colors bg-[#9D61FF]/10 text-[#9D61FF] font-medium';
      var inactiveClass = 'atlas-tab px-5 py-1.5 text-[10px] font-mono uppercase tracking-wider transition-colors text-gray-500 hover:text-gray-700 dark:hover:text-gray-300';
      tabs.forEach(function(t) {
        var panel = document.getElementById('panel-' + t);
        var tabBtn = document.getElementById('tab-' + t);
        if (!panel || !tabBtn) return;
        if (t === tab) {
          panel.style.display = '';
          tabBtn.className = activeClass + (t !== 'report' ? ' border-r border-gray-200 dark:border-gray-700' : '');
        } else {
          panel.style.display = 'none';
          tabBtn.className = inactiveClass + (t !== 'report' ? ' border-r border-gray-200 dark:border-gray-700' : '');
        }
      });
    }
    function toggleTheme() {
      var html = document.documentElement;
      if (html.classList.contains('dark')) { html.classList.remove('dark'); localStorage.setItem('atlas-theme', 'light'); }
      else { html.classList.add('dark'); localStorage.setItem('atlas-theme', 'dark'); }
    }
    function expandImage(src) {
      var overlay = document.createElement('div');
      overlay.style.cssText = 'position:fixed;inset:0;z-index:100;background:rgba(0,0,0,0.85);display:flex;align-items:center;justify-content:center;padding:2rem;cursor:pointer;backdrop-filter:blur(4px)';
      var img = document.createElement('img');
      img.src = src;
      img.style.cssText = 'max-height:90vh;max-width:90vw;object-fit:contain;box-shadow:0 25px 50px rgba(0,0,0,0.5)';
      overlay.appendChild(img);
      overlay.addEventListener('click', function() { document.body.removeChild(overlay); });
      document.body.appendChild(overlay);
    }
    window.switchTab = switchTab;
    window.toggleTheme = toggleTheme;
    window.expandImage = expandImage;
  </script>
</body>
</html>

<style is:global>
  .react-flow__controls { border-radius: 0 !important; }
  .react-flow__controls button { border-radius: 0 !important; background: white !important; border-color: #e5e7eb !important; color: #6b7280 !important; }
  .react-flow__controls button:hover { background: rgba(157,97,255,0.1) !important; color: #9D61FF !important; }
  .dark .react-flow__controls button { background: #18181b !important; border-color: #374151 !important; color: #9ca3af !important; }
  .dark .react-flow__controls button:hover { background: rgba(157,97,255,0.15) !important; color: #C4A1FF !important; }
  .react-flow__controls button svg { fill: currentColor !important; }
  .react-flow__minimap { border-radius: 0 !important; }
  .react-flow__node.atlas-dimmed { opacity: 0.12 !important; transition: opacity 0.3s !important; }
  .react-flow__node:not(.atlas-dimmed) { transition: opacity 0.3s; }
</style>
